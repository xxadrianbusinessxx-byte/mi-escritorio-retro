<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <title>Retro OS v1.0 🐬</title>
  <style is:global>
    @import url('https://fonts.googleapis.com/css2?family=VT323&display=swap');
    
    :root {
      --win-gray: #dfdfdf;
      --win-blue: #000080;
      --hot-pink: #ff1493;
    }

    body {
      font-family: 'VT323', monospace;
      cursor: url('https://cur.cursors-4u.net/games/gam-13/gam1282.png'), auto;
      background-color: #ffc0cb;
    }

    /* Efecto de líneas de TV vieja (CRT Scanlines) */
    .crt-overlay {
      position: fixed;
      top: 0; left: 0; width: 100%; height: 100%;
      background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.1) 50%), 
                  linear-gradient(90deg, rgba(255, 0, 0, 0.05), rgba(0, 255, 0, 0.02), rgba(0, 0, 255, 0.05));
      background-size: 100% 4px, 3px 100%;
      pointer-events: none;
      z-index: 50;
    }

    /* Estilo de bordes Win95 */
    .win-outset {
      border: 2px solid;
      border-color: #ffffff #808080 #808080 #ffffff;
    }
    .win-inset {
      border: 2px solid;
      border-color: #808080 #ffffff #ffffff #808080;
    }

    /* GIF flotantes */
    .floating-gif {
      position: fixed;
      z-index: 5;
      pointer-events: none;
      opacity: 0.7;
    }
  </style>
</head>

<body class="min-h-screen overflow-auto relative p-4 md:p-8">
  <div class="crt-overlay"></div>

  <div class="absolute inset-0 opacity-25 pointer-events-none" 
     style="background-image: radial-gradient(var(--hot-pink) 1.5px, transparent 1px); background-size: 25px 25px;">
  </div>

  <!-- ========== FRAME DE BIENVENIDA RETRO ========== -->
  <div class="relative z-10 max-w-6xl mx-auto mb-6">
    <div class="bg-[--win-gray] win-outset shadow-[6px_6px_0px_0px_rgba(0,0,0,0.2)]">
      <div class="bg-gradient-to-r from-[--hot-pink] to-[#ff69b4] px-3 py-1.5 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="text-white font-bold text-lg">📀 BIENVENIDO AL REPOSITORIO</span>
        </div>
        <div class="flex gap-1">
          <div class="w-4 h-4 bg-[--win-gray] win-outset"></div>
          <div class="w-4 h-4 bg-[--win-gray] win-outset"></div>
        </div>
      </div>
      <div class="p-4 text-center">
        <h1 class="text-4xl text-[--hot-pink] font-bold tracking-wide drop-shadow-md">
          Repositorio Imágenes 7w7 
        </h1>
        <p class="text-gray-700 text-lg mt-2 font-mono">
          Sube tus capturas retro, comparte sin límites
        </p>
        <div class="mt-3 flex justify-center gap-4 text-sm">
          <span class="bg-white win-inset px-3 py-0.5">📸</span>
          <span class="bg-white win-inset px-3 py-0.5">☁️ Cloudinary gratis</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Contenedor principal con dos columnas: izquierda (SYSTEM EXPLORER) y derecha (imagen aleatoria) -->
  <div class="relative z-10 max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-6">
    <!-- Columna central/izquierda: SYSTEM EXPLORER (ocupa 2/3 en escritorio, 1/1 en móvil) -->
    <div class="md:col-span-2">
      <div class="window bg-[--win-gray] win-outset shadow-[8px_8px_0px_0px_rgba(0,0,0,0.2)]">
        <div class="bg-gradient-to-r from-[--hot-pink] to-[#ff69b4] px-2 py-1 flex justify-between items-center m-0.5">
          <div class="flex items-center gap-2">
            <span class="text-white font-bold tracking-widest text-xl drop-shadow-md">📁 SYSTEM_EXPLORER.EXE</span>
          </div>
          <div class="flex gap-1">
            <button class="bg-[--win-gray] win-outset px-2 py-0.5 text-xs font-bold active:win-inset">_</button>
            <button class="bg-[--win-gray] win-outset px-2 py-0.5 text-xs font-bold active:win-inset">X</button>
          </div>
        </div>
        <div class="flex gap-4 px-4 py-1 text-sm border-b border-gray-400">
          <span class="hover:underline cursor-pointer">File</span>
          <span class="hover:underline cursor-pointer">Edit</span>
          <span class="hover:underline cursor-pointer">View</span>
          <span class="hover:underline cursor-pointer">Help</span>
        </div>
        <div class="p-4">
          <div class="bg-white win-inset p-4 min-h-[350px] overflow-y-auto max-h-[500px]">
            <div class="flex justify-between items-center mb-4 border-b border-gray-300 pb-2">
              <h2 class="text-2xl text-[--hot-pink]">ÍNDICE DE RECURSOS VISUALES</h2>
              <button id="upload-btn" class="bg-[--win-gray] win-outset px-3 py-1 text-sm font-bold hover:bg-white active:win-inset transition-all">
                📤 SUBIR IMAGEN
              </button>
              <input type="file" id="file-input" accept="image/jpeg,image/png,image/gif,image/webp" class="hidden" />
            </div>
            <div id="gallery" class="grid grid-cols-2 sm:grid-cols-3 gap-6">
              <div class="col-span-full text-center py-20">Cargando...</div>
            </div>
          </div>
        </div>
        <div class="win-inset mx-1 mb-1 px-2 py-0.5 text-sm flex justify-between bg-[--win-gray]">
          <span><span id="image-count">0</span> objeto(s) detectado(s)</span>
          <span class="border-l border-gray-400 pl-2 text-pink-600 font-bold">AESTHETIC: STABLE</span>
        </div>
      </div>
    </div>

    <!-- Columna derecha: Frame de imagen aleatoria -->
    <div class="md:col-span-1">
      <div class="bg-[--win-gray] win-outset shadow-[8px_8px_0px_0px_rgba(0,0,0,0.2)]">
        <div class="bg-gradient-to-r from-[--hot-pink] to-[#ff69b4] px-2 py-1 flex justify-between items-center">
          <span class="text-white font-bold text-sm">🎲 IMAGEN ALEATORIA</span>
          <div class="flex gap-1">
            <button id="refresh-random" class="bg-[--win-gray] win-outset px-2 py-0.5 text-xs font-bold">↻</button>
          </div>
        </div>
        <div class="p-3 bg-white win-inset">
          <div id="random-image-container" class="flex justify-center items-center min-h-[200px]">
            <img id="random-image" src="" alt="Imagen aleatoria" class="max-w-full max-h-64 object-contain" style="display: none;" />
            <div id="random-placeholder" class="text-gray-400 text-center">Cargando...</div>
          </div>
          <p class="text-[10px] text-center mt-2 text-pink-500">★ Imagen del repositorio ★</p>
        </div>
      </div>
    </div>
  </div>

  <!-- ========== BLOQUE DE AUDIO / YOUTUBE EMBED (igual que antes) ========== -->
  <div class="fixed bottom-6 right-6 w-72 bg-[--win-gray] win-outset shadow-[4px_4px_0px_0px_rgba(0,0,0,0.1)] p-1 z-20">
    <div class="bg-gray-700 text-white text-[12px] px-2 py-0.5 flex items-center gap-2">
      <span class="animate-pulse">●</span> AUDIO_ENGINE.DLL
    </div>
    <div class="p-3 bg-[#e0e0e0] win-inset flex flex-col gap-2">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-[--hot-pink] border-2 border-white flex items-center justify-center shadow-inner">
          <span class="text-white text-xl animate-bounce">♪</span>
        </div>
        <div class="overflow-hidden">
          <p class="text-xs font-bold leading-none text-gray-800 truncate">REMIX_NINTENDO_CHILL.WAV</p>
          <p class="text-[10px] text-pink-500">Retro Stream</p>
        </div>
      </div>
      <div id="youtube-video-container">
        <button id="play-stream-btn" class="w-full bg-[--win-gray] win-outset py-1 text-sm font-bold hover:bg-white active:win-inset transition-all">
          ► PLAY STREAM
        </button>
      </div>
    </div>
  </div>

  <!-- ========== GIFS FLOTANTES DECORATIVOS ========== -->
  <!-- Puedes cambiar las URLs por otros GIFs retro -->
  <img src="https://media1.tenor.com/m/-4w7fVQJf3EAAAAd/ps1-playstation.gif" class="floating-gif top-20 left-10 w-16" />
  <img src="https://media1.tenor.com/m/OpXAs3Q4SrIAAAAC/pixel-pixel-art.gif" class="floating-gif bottom-32 left-5 w-12" />
  <img src="https://media1.tenor.com/m/CeTnrQpPz-wAAAAC/waddle-dee-float.gif" class="floating-gif top-1/3 right-5 w-14" />
  <img src="https://media1.tenor.com/m/3n1VrOFAvXMAAAAC/computer-crt.gif" class="floating-gif bottom-40 right-10 w-20" />

  <!-- Iconos fijos (Papelera, Juegos) -->
  <div class="fixed top-8 left-8 flex flex-col gap-8 z-0">
    <div class="flex flex-col items-center group cursor-pointer w-20">
      <span class="text-4xl group-hover:scale-110 transition-transform">🗑️</span>
      <span class="text-xs bg-white/50 px-1 mt-1 text-pink-900">Papelera</span>
    </div>
    <div class="flex flex-col items-center group cursor-pointer w-20">
      <span class="text-4xl group-hover:scale-110 transition-transform">🎮</span>
      <span class="text-xs bg-white/50 px-1 mt-1 text-pink-900">Juegos</span>
    </div>
  </div>

  <script>
    // --- Variables globales ---
    let currentImages = [];

    // --- Cargar imágenes desde Cloudinary via API route ---
    async function loadImages() {
      try {
        const res = await fetch('/api/images.json');
        if (!res.ok) throw new Error('Error al cargar imágenes');
        const images = await res.json();
        currentImages = images;
        renderGallery(images);
        document.getElementById('image-count').innerText = images.length;
        updateRandomImage(); // actualizar la imagen aleatoria
      } catch (err) {
        console.error(err);
        const gallery = document.getElementById('gallery');
        if (gallery) {
          gallery.innerHTML = `<div class="col-span-full text-center py-20 text-red-500">⚠️ Error al conectar</div>`;
        }
      }
    }

    // --- Pintar las imágenes en la galería ---
    function renderGallery(images) {
      const gallery = document.getElementById('gallery');
      if (!gallery) return;

      if (images.length === 0) {
        gallery.innerHTML = `<div class="col-span-full text-center py-20 text-gray-400">🚫 No hay imágenes</div>`;
        return;
      }

      gallery.innerHTML = images.map(img => `
        <div class="group cursor-pointer">
          <div class="win-outset p-1 bg-[--win-gray] group-hover:bg-pink-100">
            <img src="${img.url}" alt="${img.filename}" class="w-full aspect-square object-cover grayscale group-hover:grayscale-0 border border-gray-400" />
          </div>
          <p class="text-[12px] mt-1 text-center truncate">${(img.filename || 'sin nombre').substring(0, 20)}</p>
        </div>
      `).join('');
    }

    // --- Actualizar imagen aleatoria ---
    function updateRandomImage() {
      const randomImg = document.getElementById('random-image');
      const placeholder = document.getElementById('random-placeholder');
      if (!randomImg || !placeholder) return;

      if (currentImages.length === 0) {
        randomImg.style.display = 'none';
        placeholder.style.display = 'block';
        placeholder.textContent = 'No hay imágenes aún';
        return;
      }

      const randomIndex = Math.floor(Math.random() * currentImages.length);
      const randomImageUrl = currentImages[randomIndex].url;
      randomImg.src = randomImageUrl;
      randomImg.style.display = 'block';
      placeholder.style.display = 'none';
    }

    // --- Subida directa a Cloudinary (mismo código) ---
    async function uploadImage(file) {
      if (!file) return;
      const CLOUD_NAME = 'dbkeikl8i';
      const UPLOAD_PRESET = 'retro-uploads';
      const formData = new FormData();
      formData.append('file', file);
      formData.append('upload_preset', UPLOAD_PRESET);
      const uploadBtn = document.getElementById('upload-btn');
      const originalText = uploadBtn?.innerHTML;
      if (uploadBtn) { uploadBtn.innerHTML = '⏳ SUBIENDO...'; uploadBtn.disabled = true; }
      try {
        const response = await fetch(`https://api.cloudinary.com/v1_1/${CLOUD_NAME}/upload`, { method: 'POST', body: formData });
        const data = await response.json();
        if (response.ok) {
          await loadImages();
        } else {
          alert(`Error: ${data.error.message}`);
        }
      } catch (error) {
        alert('Error de red');
      } finally {
        if (uploadBtn) { uploadBtn.innerHTML = originalText; uploadBtn.disabled = false; }
      }
    }

    function setupUpload() {
      const uploadBtn = document.getElementById('upload-btn');
      const fileInput = document.getElementById('file-input');
      if (uploadBtn && fileInput) {
        uploadBtn.addEventListener('click', () => fileInput.click());
        fileInput.addEventListener('change', (e) => {
          if (e.target.files?.length) uploadImage(e.target.files[0]);
          fileInput.value = '';
        });
      }
    }

    // --- Reproductor de YouTube embebido (igual) ---
    function setupYouTubePlayer() {
      const container = document.getElementById('youtube-video-container');
      if (!container) return;
      container.addEventListener('click', (e) => {
        const btn = e.target.closest('#play-stream-btn');
        if (btn && !container.querySelector('iframe')) {
          btn.style.display = 'none';
          const iframe = document.createElement('iframe');
          iframe.width = '100%';
          iframe.height = '150';
          iframe.src = 'https://www.youtube.com/embed/yNXjlXhehpA?autoplay=1';
          iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
          iframe.allowFullscreen = true;
          const closeBtn = document.createElement('button');
          closeBtn.textContent = '✕ CERRAR';
          closeBtn.className = 'w-full bg-gray-600 text-white text-xs py-1 mt-1 win-outset';
          closeBtn.addEventListener('click', (event) => {
            event.stopPropagation();
            container.removeChild(iframe);
            container.removeChild(closeBtn);
            btn.style.display = 'block';
          });
          container.appendChild(iframe);
          container.appendChild(closeBtn);
        }
      });
    }

    // --- Refrescar imagen aleatoria manualmente ---
    function setupRandomRefresh() {
      const refreshBtn = document.getElementById('refresh-random');
      if (refreshBtn) {
        refreshBtn.addEventListener('click', () => updateRandomImage());
      }
    }

    // --- Inicialización ---
    document.addEventListener('DOMContentLoaded', () => {
      loadImages();
      setupUpload();
      setupYouTubePlayer();
      setupRandomRefresh();
    });
  </script>
</body>
</html>
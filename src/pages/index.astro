<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width" />
  <title>Retro OS v1.0 🐬</title>
  <style is:global>
    @import url('https://fonts.googleapis.com/css2?family=VT323&display=swap');
    
    :root {
      --win-gray: #dfdfdf;
      --win-blue: #000080;
      --hot-pink:rgb(63, 15, 15);
    }

    body {
      font-family: 'VT323', monospace;
      cursor: url('https://cur.cursors-4u.net/games/gam-13/gam1282.png'), auto;
      background-color:rgb(185, 17, 59);
    }

    /* Efecto de líneas de TV vieja (CRT Scanlines) */
    .crt-overlay {
      position: fixed;
      top: 0; left: 0; width: 100%; height: 100%;
      background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.1) 50%), 
                  linear-gradient(90deg, rgba(255, 0, 0, 0.05), rgba(0, 255, 0, 0.02), rgba(0, 0, 255, 0.05));
      background-size: 100% 4px, 3px 100%;
      pointer-events: none;
      z-index: 50;
    }

    /* Estilo de bordes Win95 */
    .win-outset {
      border: 2px solid;
      border-color: #ffffff #808080 #808080 #ffffff;
    }
    .win-inset {
      border: 2px solid;
      border-color: #808080 #ffffff #ffffff #808080;
    }
  </style>
</head>

<body class="min-h-screen overflow-auto relative p-4 md:p-8">
  <div class="crt-overlay"></div>

  <div class="absolute inset-0 opacity-25 pointer-events-none" 
     style="background-image: radial-gradient(var(--hot-pink) 1.5px, transparent 1px); background-size: 25px 25px;">
  </div>

  <!-- ========== FRAMES SUPERIORES: BIENVENIDA + IMAGEN RANDOM ========== -->
  <div class="relative z-10 max-w-5xl mx-auto flex flex-col md:flex-row gap-4 mb-6">
    <!-- Frame de bienvenida (izquierda) -->
    <div class="flex-1">
      <div class="bg-[--win-gray] win-outset shadow-[6px_6px_0px_0px_rgba(0,0,0,0.2)]">
        <div class="bg-gradient-to-r from-[--hot-pink] to-[#585858] px-3 py-1.5 flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="text-white font-bold text-lg">📀 BIENVENIDO AL REPOSITORIO</span>
          </div>
          <div class="flex gap-1">
            <div class="w-4 h-4 bg-[--win-gray] win-outset"></div>
            <div class="w-4 h-4 bg-[--win-gray] win-outset"></div>
          </div>
        </div>
        <div class="p-4 text-center">
          <h1 class="text-3xl text-[--hot-pink] font-bold tracking-wide drop-shadow-md">
            Repositorio Imágenes 7w7 
          </h1>
          <p class="text-gray-700 text-base mt-2 font-mono">
            Sube tus capturas retro, comparte sin límites
          </p>
          <div class="mt-3 flex justify-center gap-4 text-sm">
            <span class="bg-white win-inset px-3 py-0.5">📸</span>
            <span class="bg-white win-inset px-3 py-0.5">☁️ Cloudinary</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Frame imagen random (derecha) -->
    <div class="flex-1">
      <div class="bg-[--win-gray] win-outset shadow-[6px_6px_0px_0px_rgba(0,0,0,0.2)] h-full">
        <div class="bg-gradient-to-r from-[--hot-pink] to-[#585858] px-2 py-1 flex items-center justify-between">
          <span class="text-white font-bold text-sm">🎲 IMAGEN RANDOM</span>
          <div class="flex gap-1">
            <button id="refresh-random-btn" class="bg-[--win-gray] win-outset px-1 text-xs font-bold hover:bg-white active:win-inset">🔄</button>
          </div>
        </div>
        <div class="p-3 flex flex-col items-center">
          <div id="random-image-container" class="win-inset p-1 bg-white w-full flex justify-center">
            <img id="random-img" src="" alt="Random" class="w-full h-40 object-cover grayscale group-hover:grayscale-0" />
          </div>
          <p id="random-filename" class="text-[11px] mt-2 text-center truncate text-gray-600"></p>
          <button id="random-btn" class="mt-2 bg-[--win-gray] win-outset px-2 py-0.5 text-xs font-bold hover:bg-white active:win-inset w-full">
            🎲 Otra aleatoria
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- ========== VENTANA PRINCIPAL SYSTEM EXPLORER ========== -->
  <div class="window relative z-10 w-full max-w-5xl mx-auto bg-[--win-gray] win-outset shadow-[8px_8px_0px_0px_rgba(0,0,0,0.2)]">
    
    <div class="bg-gradient-to-r from-[--hot-pink] to-[#585858] px-2 py-1 flex justify-between items-center m-0.5">
      <span class="text-white font-bold tracking-widest text-xl drop-shadow-md">📁 SYSTEM_EXPLORER.EXE</span>
      <div class="flex gap-1">
        <button class="bg-[--win-gray] win-outset px-2 py-0.5 text-xs font-bold active:win-inset">_</button>
        <button class="bg-[--win-gray] win-outset px-2 py-0.5 text-xs font-bold active:win-inset">X</button>
      </div>
    </div>

    <div class="flex gap-4 px-4 py-1 text-sm border-b border-gray-400">
      <span class="hover:underline cursor-pointer">File</span>
      <span class="hover:underline cursor-pointer">Edit</span>
      <span class="hover:underline cursor-pointer">View</span>
      <span class="hover:underline cursor-pointer">Help</span>
    </div>

    <div class="p-4">
      <div class="bg-white win-inset p-4 min-h-[350px] overflow-y-auto max-h-[500px]">
        
        <div class="flex justify-between items-center mb-4 border-b border-gray-300 pb-2">
          <h2 class="text-2xl text-[--hot-pink]">ÍNDICE DE RECURSOS VISUALES</h2>
          <button id="upload-btn" class="bg-[--win-gray] win-outset px-3 py-1 text-sm font-bold hover:bg-white active:win-inset transition-all">
            📤 SUBIR IMAGEN
          </button>
          <input type="file" id="file-input" accept="image/jpeg,image/png,image/gif,image/webp" class="hidden" />
        </div>

        <div id="gallery" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-6">
          <div class="col-span-full text-center py-20">Cargando...</div>
        </div>

      </div>
    </div>

    <div class="win-inset mx-1 mb-1 px-2 py-0.5 text-sm flex justify-between bg-[--win-gray]">
      <span><span id="image-count">0</span> objeto(s) detectado(s)</span>
      <span class="border-l border-gray-400 pl-2 text-pink-600 font-bold">AESTHETIC: STABLE</span>
    </div>
  </div>

  <!-- ========== BLOQUE DE AUDIO / YOUTUBE CON MINIMIZAR ========== -->
  <div id="youtube-block" class="fixed bottom-6 right-6 w-72 bg-[--win-gray] win-outset shadow-[4px_4px_0px_0px_rgba(0,0,0,0.1)] p-1 z-20">
    <div class="bg-gray-700 text-white text-[12px] px-2 py-0.5 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="animate-pulse">●</span> AUDIO_ENGINE.DLL
      </div>
      <button id="minimize-youtube-btn" class="bg-[--win-gray] win-outset px-1 text-xs font-bold">–</button>
    </div>
    <div id="youtube-content" class="p-3 bg-[#e0e0e0] win-inset flex flex-col gap-2">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 bg-[--hot-pink] border-2 border-white flex items-center justify-center shadow-inner">
          <span class="text-white text-xl animate-bounce">♪</span>
        </div>
        <div class="overflow-hidden">
          <p class="text-xs font-bold leading-none text-gray-800 truncate">REMIX_NINTENDO_CHILL.WAV</p>
          <p class="text-[10px] text-pink-500">Retro Stream</p>
        </div>
      </div>
      <div id="youtube-video-container">
        <button id="play-stream-btn" class="w-full bg-[--win-gray] win-outset py-1 text-sm font-bold hover:bg-white active:win-inset transition-all">
          ► PLAY STREAM
        </button>
      </div>
    </div>
  </div>
  
  <script>
    let currentImages = [];

    // --- Cargar imágenes desde Cloudinary ---
    async function loadImages() {
      try {
        const res = await fetch('/api/images.json');
        if (!res.ok) throw new Error('Error al cargar imágenes');
        const images = await res.json();
        currentImages = images;
        renderGallery(images);
        document.getElementById('image-count').innerText = images.length;
        updateRandomImage(); // actualizar la random con la nueva lista
      } catch (err) {
        console.error(err);
        document.getElementById('gallery').innerHTML = `<div class="col-span-full text-center py-20 text-red-500">Error...</div>`;
      }
    }

    function renderGallery(images) {
      const gallery = document.getElementById('gallery');
      if (!gallery) return;
      if (images.length === 0) {
        gallery.innerHTML = `<div class="col-span-full flex flex-col items-center justify-center py-20 text-gray-400">🚫 No hay imágenes</div>`;
        return;
      }
      gallery.innerHTML = images.map(img => `
        <div class="group cursor-pointer">
          <div class="win-outset p-1 bg-[--win-gray] group-hover:bg-pink-100 transition-colors">
            <img src="${img.url}" alt="${img.filename}" class="w-full aspect-square object-cover grayscale group-hover:grayscale-0 border border-gray-400" />
          </div>
          <p class="text-[12px] mt-1 text-center truncate text-gray-600 font-bold uppercase">${(img.filename || 'sin nombre').substring(0, 20)}</p>
        </div>
      `).join('');
    }

    // --- Imagen aleatoria ---
    function updateRandomImage() {
      if (currentImages.length === 0) {
        document.getElementById('random-img').src = '';
        document.getElementById('random-filename').innerText = 'No hay imágenes';
        return;
      }
      const randomIndex = Math.floor(Math.random() * currentImages.length);
      const img = currentImages[randomIndex];
      document.getElementById('random-img').src = img.url;
      document.getElementById('random-filename').innerText = img.filename.substring(0, 30);
    }

    // --- Subida directa a Cloudinary ---
    async function uploadImage(file) {
      if (!file) return;
      const CLOUD_NAME = 'dbkeikl8i';          // <--- TU CLOUD NAME
      const UPLOAD_PRESET = 'retro-uploads';   // <--- TU UPLOAD PRESET
      const formData = new FormData();
      formData.append('file', file);
      formData.append('upload_preset', UPLOAD_PRESET);

      const uploadBtn = document.getElementById('upload-btn');
      const originalText = uploadBtn?.innerHTML;
      if (uploadBtn) { uploadBtn.innerHTML = '⏳ SUBIENDO...'; uploadBtn.disabled = true; }

      try {
        const url = `https://api.cloudinary.com/v1_1/${CLOUD_NAME}/upload`;
        const response = await fetch(url, { method: 'POST', body: formData });
        const data = await response.json();
        if (response.ok) {
          await loadImages();
        } else {
          alert(`Error: ${data.error.message}`);
        }
      } catch (error) {
        alert('Error de red');
      } finally {
        if (uploadBtn) { uploadBtn.innerHTML = originalText; uploadBtn.disabled = false; }
      }
    }

    // --- Reproductor YouTube con minimizar ---
    function setupYouTube() {
      const container = document.getElementById('youtube-video-container');
      const minimizeBtn = document.getElementById('minimize-youtube-btn');
      const contentDiv = document.getElementById('youtube-content');
      let isMinimized = false;

      minimizeBtn.addEventListener('click', () => {
        if (isMinimized) {
          contentDiv.style.display = 'flex';
          minimizeBtn.textContent = '–';
        } else {
          contentDiv.style.display = 'none';
          minimizeBtn.textContent = '+';
        }
        isMinimized = !isMinimized;
      });

      // Lógica del reproductor (PLAY y cerrar)
      container.addEventListener('click', (e) => {
        const btn = e.target.closest('#play-stream-btn');
        if (btn && !container.querySelector('iframe')) {
          btn.style.display = 'none';
          const iframe = document.createElement('iframe');
          iframe.width = '100%';
          iframe.height = '150';
          iframe.src = 'https://www.youtube.com/embed/yNXjlXhehpA?autoplay=1';
          iframe.title = "YouTube";
          iframe.frameBorder = "0";
          iframe.allow = "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
          iframe.allowFullscreen = true;
          iframe.className = "mt-2 rounded-sm";
          const closeBtn = document.createElement('button');
          closeBtn.textContent = '✕ CERRAR';
          closeBtn.className = 'w-full bg-gray-600 text-white text-xs py-1 mt-1 win-outset hover:bg-gray-700 transition-all';
          closeBtn.addEventListener('click', (event) => {
            event.stopPropagation();
            container.removeChild(iframe);
            container.removeChild(closeBtn);
            btn.style.display = 'block';
          });
          container.appendChild(iframe);
          container.appendChild(closeBtn);
        }
      });
    }

    function setupUploadButton() {
      const uploadBtn = document.getElementById('upload-btn');
      const fileInput = document.getElementById('file-input');
      uploadBtn.addEventListener('click', () => fileInput.click());
      fileInput.addEventListener('change', (e) => {
        if (e.target.files.length) uploadImage(e.target.files[0]);
        fileInput.value = '';
      });
    }

    function setupRandomButton() {
      const randomBtn = document.getElementById('random-btn');
      const refreshBtn = document.getElementById('refresh-random-btn');
      randomBtn.addEventListener('click', () => updateRandomImage());
      refreshBtn.addEventListener('click', () => updateRandomImage());
    }

    document.addEventListener('DOMContentLoaded', () => {
      loadImages();
      setupUploadButton();
      setupRandomButton();
      setupYouTube();
    });
  </script>
</body>
</html>